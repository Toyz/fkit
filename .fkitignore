# Paths fkit does not track when this repository is hosted in fkit itself.
#
# The pattern language is .gitignore's: a bare name matches at any depth, a
# rule with a `/` in it (`/patch/`, `web/dist/`) is a path from this file's
# directory, and `*`, `?`, `[...]`, `**` and `!` mean what they mean there.
# See `Ignore` in crates/fkit-core/src/ingest.rs for the whole grammar.

# git's own state. fkit tracks this tree, not git's bookkeeping about it —
# and .git churns on every git operation, so a snapshot would never settle.
.git/

# Build output — regenerable, and huge.
target/
node_modules/
dist/

# Local data: object stores and anything `make dev` writes.
fkit-data/
fkit-hub-data/
.dev/

# Generated secrets — never committed.
.env
.env.prod

# Local overrides.
fkit-hub.toml
docker-compose.override.yml

# Local Playwright harness, not part of the source.
e2e/

# Editor and OS noise
.DS_Store
*.swp
