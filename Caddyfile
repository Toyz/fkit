# TLS for fkit.work.
#
# Caddy gets and renews a Let's Encrypt certificate on its own, so there is no
# certbot, no cron, and no renewal that quietly stops working. It needs ports
# 80 and 443 reachable from the internet — port 80 is how the ACME HTTP
# challenge proves you control the name, not just a redirect.
#
# reverse_proxy forwards WebSocket upgrades unchanged, which matters more here
# than for most sites: fkit's sync protocol is WebSocket end to end, so a proxy
# that mishandles Upgrade breaks push and clone while leaving the web UI
# looking perfectly healthy.

fkit.work {
	reverse_proxy hub:7500

	# The hub streams whole objects during a clone and a large push can take
	# minutes. The defaults would cut those off mid-transfer.
	timeouts {
		read_body 30m
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}
}
