# Reference only — do NOT copy this file to .env.
#
# Run `make setup` (or scripts/setup-env.sh) instead. It generates .env with
# real random secrets. There are deliberately no working values here, so a
# copied-and-forgotten example cannot become a production credential.

# Postgres password for the hub's database. Required.
POSTGRES_PASSWORD=

# Host port for the web UI + sync endpoint. Default 7500.
HUB_PORT=

# Shared token for the optional standalone fkitd daemon
# (docker compose --profile standalone up -d). Required for that profile only.
FKIT_TOKEN=
FKITD_PORT=

# Password resets, via Resend. Optional: with no key the hub has no reset flow
# and the sign-in page omits the link rather than offering one that fails.
# The key from here overrides anything set in Settings -> Email in the web UI,
# so a key kept in a secret manager stays the single source of truth.
RESEND_API_KEY=

# Sender address. The domain must be verified with Resend or every message is
# rejected. e.g. hub@fkit.work
FKIT_EMAIL_FROM=

# Base URL that reset links are built from, e.g. https://fkit.work. Behind a
# proxy the request's own Host is not reliable, so state it here.
FKIT_PUBLIC_URL=

# Log filter, e.g. fkit_hub=debug,tower_http=info
RUST_LOG=
