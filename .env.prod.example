# Secrets only. Everything else lives in hub.toml, which the compose file
# mounts at /etc/fkit/hub.toml. Copy this to .env.prod on the server.

# Bundled database (with --profile bundled-db). Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Or point at a database you already have and drop --profile bundled-db.
# DATABASE_URL=postgres://user:pass@host:5432/fkit_hub

# Password resets and invitation mail. Blank = no reset flow, and the sign-in
# page says so instead of offering one that cannot work.
RESEND_API_KEY=

# RUST_LOG=fkit_hub=info,tower_http=warn
