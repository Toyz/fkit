# Deployment settings for docker-compose.prod.yml.
# Copy to .env.prod on the server and fill in. Never commit the filled copy.

# ---- database ----
# Pick ONE.
#
# (a) Use a database you already have — a managed Postgres, or a server you
#     already run. Set this and start without --profile bundled-db; nothing
#     local starts and POSTGRES_PASSWORD is not used.
# DATABASE_URL=postgres://user:pass@host:5432/fkit_hub
#
# (b) Use the bundled Postgres. Set a password and start with
#     --profile bundled-db.  Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
# POSTGRES_USER=fkit
# POSTGRES_DB=fkit_hub

# Which address the hub listens on.
# With the tls profile (Caddy in front) leave this alone: Caddy reaches the hub
# over the compose network and the hub stays off every public interface.
# Without it, this IS the access control — set it to the server's address on
# whatever private network should be able to reach the hub.
BIND_ADDR=127.0.0.1
HUB_PORT=7500

# Set to 1 when a TLS proxy is in front (the tls profile). Leave blank for
# plain http on a private network — a Secure cookie over http is discarded by
# the browser, and the symptom is a login that appears to work and doesn't.
FKIT_SECURE_COOKIES=1

# The published image and tag to run.
FKIT_IMAGE=ghcr.io/toyz/fkit-hub
FKIT_TAG=latest

# Base URL for links in outbound mail. Must be an address the recipient can
# actually open.
FKIT_PUBLIC_URL=https://fkit.work

# Password resets and invites. Optional; with no key the hub simply has no
# reset flow and says so on the sign-in page.
RESEND_API_KEY=
FKIT_EMAIL_FROM=hub@fkit.work

RUST_LOG=fkit_hub=info,tower_http=warn
